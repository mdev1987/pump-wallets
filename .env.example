# -----------------------------------------------------------------------------
# Solana Pump Wallet Research - final configuration
# Copy to .env and set HELIUS_API_KEY.
# All scanner parameters are explicit; the TypeScript code contains no strategy
# defaults.
# -----------------------------------------------------------------------------

HELIUS_API_KEY=YOUR_HELIUS_API_KEY
HELIUS_RPC_BASE_URL=https://mainnet.helius-rpc.com

# Helius request sizes / history limits.
HELIUS_PAGE_LIMIT=100
MAX_HISTORY_PAGES=2000
HELIUS_LIGHT_PAGE_LIMIT=1000
MAX_LIGHT_HISTORY_PAGES=20000
# Fail fast on ultra-dense tokens: light signatures above this abort the token
# with a clear error instead of burning full-fetch credits + RAM for a scan
# that would exceed MAX_FULL_QUERY_WINDOWS anyway. Raise on bigger machines.
MAX_LIGHT_SIGNATURES=100000
HELIUS_CACHE_ENABLED=true
HELIUS_CACHE_DIR=./data/helius_cache
HELIUS_LIGHT_CACHE_TTL_SEC=86400
HELIUS_FULL_CACHE_TTL_SEC=86400

# Transport pacing. 350 ms on 1-2 vCPU / 2GB VPS to reduce CPU spikes + 429
# retries. 250 ms (~= 4 req/s) suits bigger machines.
HELIUS_MIN_INTERVAL_MS=350
RETRY_ATTEMPTS=6
RETRY_BACKOFF_MS=1000

# Stage 1: lightweight activity discovery.
# Count signatures into 1-minute buckets, find the busiest 5-minute regions,
# then fetch full transactions only around those regions.
ACTIVITY_BUCKET_SEC=60
ACTIVE_WINDOW_SEC=300
ACTIVE_WINDOW_COUNT=4
MIN_ACTIVE_WINDOW_TRANSACTIONS=100
ACTIVE_WINDOW_CONTEXT_SEC=180
ACTIVE_WINDOW_MERGE_GAP_SEC=120
# Full-fetch ranges merge only when they actually overlap. Pump clustering can use a larger gap.
FULL_WINDOW_MERGE_GAP_SEC=0
QUIET_WINDOW_SEC=300
QUIET_WINDOW_COUNT=1
MIN_QUIET_WINDOW_TRANSACTIONS=5
QUIET_SEARCH_START_SEC=900
QUIET_SEARCH_END_SEC=7200
QUIET_WINDOW_CONTEXT_SEC=60
FINE_ACTIVITY_BUCKET_SEC=1

# Stage 2 full-transaction safety budget.
# Windows are split before full retrieval so the expected transaction count per
# query stays bounded. This is a safety budget, not a silent truncation limit.
# 2GB VPS: 2500 tx/window bounds the retained Trade[] peak; 32 admits marginal
# DeBot tokens while ultra-dense ones (>32 split windows) still fail closed
# instead of OOMing. 16GB workstations can use 5000/64.
MAX_FULL_TRANSACTIONS_PER_WINDOW=2500
MAX_FULL_QUERY_WINDOWS=32

# Trade reconstruction / market buckets.
MIN_MARKET_TRADE_SOL=0.01
MIN_LEADER_TRADE_SOL=0.05
BUCKET_SEC=1

# Pump detection.
# A pump needs an absolute short-term move, confirmation, positive net buy flow,
# elevated local transaction pace, and strong buy pressure.
PUMP_LOOKBACK_SEC=15
PUMP_ACCEL_RETURN=0.09
PUMP_CONFIRM_SEC=30
PUMP_CONFIRM_RETURN=0.15
PUMP_MIN_BUY_SOL=5
PUMP_BASELINE_SEC=180
PUMP_MIN_VOLUME_PACE=1.50
PUMP_MIN_BUY_PRESSURE=0.60
PUMP_SUSTAINED_LOOKBACK_SEC=60
PUMP_SUSTAINED_RETURN=0.12
PUMP_SUSTAINED_CONFIRM_SEC=60
PUMP_SUSTAINED_CONFIRM_RETURN=0.08
PUMP_SUSTAINED_MIN_BUY_SOL=3
PUMP_SUSTAINED_MIN_VOLUME_PACE=1.25
PUMP_SUSTAINED_MIN_BUY_PRESSURE=0.55
PUMP_CLUSTER_SEC=120
PUMP_WINDOW_SEC=120

# Wallet timing / response.
# 120 seconds allows accumulation evidence while still decaying strongly toward
# the immediate pre-pump period.
PRE_PUMP_SEC=120
EARLY_PUMP_SEC=60
TOP_WALLETS=20
LEAD_FLOW_WINDOW_SEC=30
LEADER_RESPONSE_SCALE=0.50
LEADER_TIMING_DECAY_SEC=30
FORWARD_MAX_EXTRA_GAP_SEC=30

FORWARD_1S_SEC=1
FORWARD_3S_SEC=3
FORWARD_5S_SEC=5
FORWARD_10S_SEC=10
FORWARD_15S_SEC=15
FORWARD_30S_SEC=30
FORWARD_60S_SEC=60

PUMP_POSITIVE_RATE_THRESHOLD=0.50
RELIABILITY_PRIOR_PUMPS=2

# Matched non-leading control baseline.
# Context is intentionally large enough to cover this interval plus PRE_PUMP and
# CONTROL_GAP around a pump start.
CONTROL_LOOKBACK_SEC=180
CONTROL_GAP_SEC=15
MIN_CONTROL_TRADE_SOL=0.05
MIN_CONTROL_BUYS_PER_PUMP=10
MAX_CONTROL_BUYS_PER_PUMP=100

# Persistent research database / exports.
# 1 thread on 2GB / 1-2 vCPU VPS; memory capped to 600MB in code (src/duckdb.ts).
DUCKDB_PATH=./data/pump_wallets.duckdb
DUCKDB_THREADS=1
TOKEN_OUTPUT_ROOT=./data/pump_wallet_tnxs
GLOBAL_EXPORT_DIR=./data/pump_wallet_exports
LOG_DIR=./logs

# -----------------------------------------------------------------------------
# DeBot candidate discovery.
# -----------------------------------------------------------------------------
DEBOT_ENABLED=true
DEBOT_SCAN_CANDIDATES=true
DEBOT_BASE_URL=https://debot.ai/api
DEBOT_CHAIN=solana
DEBOT_RANK_LIMIT=50
DEBOT_REQUEST_TIMEOUT_MS=10000
DEBOT_API_KEY=
DEBOT_POLL_INTERVAL_MS=60000
DEBOT_CANDIDATE_LIMIT=12
DEBOT_MIN_PUMP_PRECURSOR_SCORE=50
DEBOT_MIN_PUMP_PRECURSOR_EVIDENCE=3
DEBOT_MIN_PUMP_PRECURSOR_POSITIVE_EVIDENCE=1
DEBOT_MIN_ACTIVITY_SCORE=0
DEBOT_MIN_ACTIVITY_EVIDENCE=1
DEBOT_MIN_VOLUME_ACCELERATION=1.0
DEBOT_REQUIRE_1M=true
DEBOT_INCLUDE_1M_ONLY=true
DEBOT_ACCELERATION_SATURATION=3
DEBOT_ACTIVITY_SCORE_SATURATION=1
DEBOT_BUY_PRESSURE_DELTA_SATURATION=0.25
DEBOT_REQUIRE_HEATMAP=false
DEBOT_MAX_HEATMAP_RECENCY_SEC=900
DEBOT_RETRY_ATTEMPTS=4
DEBOT_RETRY_BACKOFF_MS=500

# DeBot score weights. Activity is candidate context; Helius validates the pump.
DEBOT_SCORE_WEIGHT_ACTIVITY_RANK_1M=20
DEBOT_SCORE_WEIGHT_ACTIVITY_RANK_5M=10
DEBOT_SCORE_WEIGHT_ACTIVITY_INTENSITY=5
DEBOT_SCORE_WEIGHT_BUY_PRESSURE_1M=20
DEBOT_SCORE_WEIGHT_BUY_PRESSURE_DELTA=15
DEBOT_SCORE_WEIGHT_VOLUME_ACCELERATION=15
DEBOT_SCORE_WEIGHT_WALLET_ACCELERATION=10
